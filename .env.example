# Future Phase 0 lead-funnel provider placeholders.
# These are public non-secret URLs only.
# Local development should leave both MailerLite form URLs empty.
# Preview uses only NEXT_PUBLIC_MAILERLITE_PREVIEW_FORM_URL.
# Production form activation remains blocked until approved.
# Never place subscriber data in environment values.
NEXT_PUBLIC_MAILERLITE_PREVIEW_FORM_URL=
NEXT_PUBLIC_MAILERLITE_PRODUCTION_FORM_URL=
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# Phase 0 legal-configuration gate for /privacidad and /tratamiento-de-datos.
# Server-only (no NEXT_PUBLIC_ prefix): these render only on the server so
# nothing is exposed in the client bundle before the owner and a professional
# legal review approve publication. Leave all values empty/false until then.
# All five must be set (and the boolean must be "true") before either route
# renders a complete policy instead of the safe incomplete-state notice.
LEGAL_RESPONSIBLE_PARTY_NAME=
LEGAL_RESPONSIBLE_PARTY_IDENTIFICATION=
LEGAL_RESPONSIBLE_PARTY_CITY=
LEGAL_PRIVACY_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=
LEGAL_PROFESSIONAL_REVIEW_COMPLETED=false
